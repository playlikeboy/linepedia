---
import { Search } from 'lucide-astro';
---

<section class="relative pt-20 pb-24 md:pt-28 md:pb-32 overflow-hidden">
  {/* Premium Background Background */}
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-[#fdfcf7]"></div>
    <div class="absolute top-0 right-0 w-[80%] h-[80%] bg-linear-to-br from-stone-100/70 to-amber-50/40 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/4"></div>
    <div class="absolute bottom-0 left-0 w-[60%] h-[60%] bg-linear-to-tr from-accent/7 to-stone-100/60 rounded-full blur-[100px] translate-y-1/2 -translate-x-1/4"></div>
  </div>

  <div class="container mx-auto px-4 relative z-10 flex flex-col items-center text-center">
    <div class="inline-flex items-center space-x-2 px-4 py-2 bg-white/50 backdrop-blur-md border border-indigo-100/50 rounded-full mb-8 animate-in fade-in slide-in-from-top-4 duration-1000">
      <div class="w-2 h-2 bg-accent rounded-full animate-pulse"></div>
      <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary/60">Curated poetry archive</span>
    </div>

    <h1 class="text-4xl md:text-6xl lg:text-[5.5rem] font-serif font-black text-primary mb-8 leading-[0.9] tracking-tight animate-in fade-in slide-in-from-bottom-8 duration-1000 delay-200">
      Find the words
      <br />
      you were looking for.
    </h1>

    <p class="text-primary/60 text-lg md:text-xl mb-12 max-w-2xl mx-auto leading-relaxed font-light animate-in fade-in slide-in-from-bottom-8 duration-1000 delay-400">
      A quiet archive of shayari, poems, quotes, and poetic lines — with writers, context, meanings, and collections to explore.
    </p>

    {/* Hero Search - Premium Glassmorphism */}
    <form action="/explore/" method="get" class="relative max-w-3xl mx-auto w-full group animate-in fade-in slide-in-from-bottom-8 duration-1000 delay-600">
      <div class="absolute inset-y-0 left-8 flex items-center pointer-events-none text-primary/30 group-focus-within:text-accent transition-all duration-500">
        <Search size={28} />
      </div>
      <input 
        name="q"
        type="search" 
        placeholder="Search for keywords, authors, or themes..." 
        class="w-full bg-white/80 backdrop-blur-2xl border-2 border-indigo-50/50 rounded-2xl py-5 pl-16 pr-32 shadow-lg shadow-primary/5 focus:outline-none focus:border-accent/30 focus:shadow-accent/5 transition-all text-base md:text-lg placeholder:font-light placeholder:text-primary/20"
      />
      <div class="absolute right-2 inset-y-2 hidden md:block">
        <button type="submit" class="bg-primary text-white h-full px-7 rounded-xl font-bold text-lg hover:bg-primary/90 hover:scale-[1.02] active:scale-[0.98] transition-all shadow-xl shadow-primary/20">
          Discover
        </button>
      </div>
    </form>

    {/* Trending Tags - Premium Pills */}
    <div class="mt-6 flex flex-wrap justify-center gap-2 animate-in fade-in slide-in-from-bottom-8 duration-1000 delay-800">
      {['sad-shayari', 'jaun-elia', 'deep-captions', '2-line-love'].map((tag, i) => (
        <a
          href={`/${tag}/`}
          class="px-4 py-2 bg-white/55 backdrop-blur-md border border-primary/10 rounded-full hover:bg-white hover:border-accent/20 hover:scale-110 active:scale-95 transition-all text-primary/60 hover:text-accent font-bold text-sm"
        >
          #{tag.replace(/-/g, ' ')}
        </a>
      ))}
    </div>

    {/* High-Intent Entry Points */}
    <div class="mt-5 flex flex-wrap justify-center gap-2 animate-in fade-in slide-in-from-bottom-8 duration-1000 delay-1000">
      {[
        { name: 'Sad Shayari', href: '/sad-shayari/' },
        { name: 'Love Shayari', href: '/love-poetry/' },
        { name: 'Deep Lines', href: '/deep-lines/' },
        { name: 'Urdu Poetry', href: '/categories/' },
        { name: 'Instagram Captions', href: '/explore/' },
        { name: 'WhatsApp Status', href: '/explore/' },
        { name: 'Famous Poets', href: '/writers/' },
        { name: 'Quote Posters', href: '/posters/' },
      ].map((item) => (
        <a
          href={item.href}
          class="px-4 py-2 text-xs font-bold text-primary/50 hover:text-accent bg-white/30 hover:bg-white/60 border border-transparent hover:border-indigo-100/50 rounded-full transition-all"
        >
          {item.name}
        </a>
      ))}
    </div>
  </div>
</section>
