---
import { Search, Menu, Home, Compass, PenTool, LayoutGrid, BookOpen, Image, Code, X } from 'lucide-astro';

const navItems = [
  { name: 'Explore', href: '/explore/', icon: Compass },
  { name: 'Categories', href: '/categories/', icon: LayoutGrid },
  { name: 'Writers', href: '/writers/', icon: PenTool },
  { name: 'Collections', href: '/collections/', icon: BookOpen },
  { name: 'Blog', href: '/blog/', icon: BookOpen },
];

const secondaryItems = [
  { name: 'Posters', href: '/posters/', icon: Image },
  { name: 'API', href: '/api/', icon: Code },
];

const languages = [
  { code: 'en', name: 'English' },
  { code: 'hi', name: 'हिन्दी' },
  { code: 'ar', name: 'العربية' },
  { code: 'es', name: 'Español' },
  { code: 'fr', name: 'Français' },
  { code: 'de', name: 'Deutsch' },
  { code: 'zh', name: '中文' },
  { code: 'ja', name: '日本語' },
  { code: 'ru', name: 'Русский' },
  { code: 'pt', name: 'Português' },
  { code: 'it', name: 'Italiano' },
];
---

<header class="sticky top-0 z-50 bg-cream/92 backdrop-blur-lg border-b border-primary/10">
  <div class="container mx-auto px-4 h-[4.25rem] flex items-center justify-between gap-4">
    <a href="/" class="shrink-0 text-[1.55rem] md:text-2xl font-serif font-black text-primary tracking-tight" aria-label="Linespedia home">
      Linespedia
    </a>

    <nav class="hidden lg:flex items-center gap-6 xl:gap-7" aria-label="Primary">
      {navItems.map(item => (
        <a href={item.href} class="text-[11px] font-semibold text-primary/55 hover:text-accent transition-colors uppercase tracking-[0.16em]">
          {item.name}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1.5 sm:gap-3">
      <a href="/explore/" aria-label="Search poetry" class="p-2 text-primary/55 hover:text-accent transition-colors">
        <Search size={18} />
      </a>

      <div class="relative group hidden sm:flex items-center">
        <button type="button" aria-label="Choose language" class="flex items-center gap-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-primary/55 hover:text-accent transition-colors py-2">
          <span>Language</span>
        </button>
        <div class="absolute top-full right-0 mt-2 w-44 bg-paper/98 border border-primary/10 rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 p-2 z-50">
          {languages.map(lang => (
            <button type="button" class="lang-select-btn w-full rounded-lg px-3 py-2 text-left text-xs font-semibold text-primary/70 hover:text-accent hover:bg-primary/5 transition-colors" data-lang={lang.code}>
              {lang.name}
            </button>
          ))}
        </div>
      </div>

      <a href="/submit/" class="hidden md:inline-flex px-5 py-2.5 bg-primary text-white text-[11px] font-bold uppercase tracking-[0.16em] rounded-full hover:bg-primary/90 transition-colors">
        Submit
      </a>

      <button
        class="md:hidden p-2 text-primary"
        id="mobile-menu-btn"
        type="button"
        aria-label="Open navigation"
        aria-controls="mobile-navigation"
        aria-expanded="false"
      >
        <Menu size={22} />
      </button>
    </div>
  </div>
</header>

<div id="mobile-navigation" class="hidden fixed inset-x-3 top-[4.75rem] z-50 max-h-[calc(100vh-6rem)] overflow-y-auto rounded-2xl border border-primary/10 bg-paper/98 shadow-2xl p-5 md:hidden">
  <div class="flex items-center justify-between pb-4 border-b border-primary/10">
    <span class="font-serif text-xl font-bold">Explore Linespedia</span>
    <button id="mobile-menu-close" type="button" class="p-2 text-primary/60" aria-label="Close navigation">
      <X size={20} />
    </button>
  </div>

  <nav class="grid gap-1 mt-4" aria-label="Mobile primary">
    <a href="/" class="rounded-xl px-4 py-3 text-sm font-semibold hover:bg-primary/5">Home</a>
    {navItems.map(item => <a href={item.href} class="rounded-xl px-4 py-3 text-sm font-semibold hover:bg-primary/5">{item.name}</a>)}
    {secondaryItems.map(item => <a href={item.href} class="rounded-xl px-4 py-3 text-sm font-semibold text-primary/65 hover:bg-primary/5">{item.name}</a>)}
  </nav>

  <div class="mt-4 border-t border-primary/10 pt-4">
    <p class="px-4 pb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-primary/40">Language</p>
    <div class="grid grid-cols-2 gap-1">
      {languages.map(lang => (
        <button type="button" class="lang-select-btn rounded-lg px-3 py-2 text-left text-xs font-semibold hover:bg-primary/5" data-lang={lang.code}>
          {lang.name}
        </button>
      ))}
    </div>
  </div>

  <a href="/submit/" class="mt-5 block rounded-xl bg-primary px-4 py-3 text-center text-xs font-bold uppercase tracking-[0.16em] text-white">
    Submit a line
  </a>
</div>

<nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-paper/95 backdrop-blur-xl border-t border-primary/10 px-4 py-2 shadow-[0_-8px_24px_rgba(40,35,79,0.08)]" aria-label="Mobile quick navigation">
  <div class="flex items-center justify-around">
    <a href="/" class="flex flex-col items-center gap-1 text-primary">
      <Home size={19} />
      <span class="text-[9px] font-semibold uppercase tracking-wider">Home</span>
    </a>
    <a href="/explore/" class="flex flex-col items-center gap-1 text-primary/60">
      <Compass size={19} />
      <span class="text-[9px] font-semibold uppercase tracking-wider">Explore</span>
    </a>
    <a href="/categories/" class="flex flex-col items-center gap-1 text-primary/60">
      <LayoutGrid size={19} />
      <span class="text-[9px] font-semibold uppercase tracking-wider">Browse</span>
    </a>
    <a href="/writers/" class="flex flex-col items-center gap-1 text-primary/60">
      <PenTool size={19} />
      <span class="text-[9px] font-semibold uppercase tracking-wider">Writers</span>
    </a>
    <a href="/submit/" class="flex flex-col items-center gap-1 text-primary/60">
      <BookOpen size={19} />
      <span class="text-[9px] font-semibold uppercase tracking-wider">Submit</span>
    </a>
  </div>
</nav>

<style>
  @media (max-width: 768px) {
    :global(body) { padding-bottom: 64px; }
  }
</style>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-menu-close');
  const mobileNav = document.getElementById('mobile-navigation');

  function setMenu(open: boolean) {
    mobileNav?.classList.toggle('hidden', !open);
    menuBtn?.setAttribute('aria-expanded', String(open));
  }

  menuBtn?.addEventListener('click', () => setMenu(true));
  closeBtn?.addEventListener('click', () => setMenu(false));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });

  document.querySelectorAll('.lang-select-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = (btn as HTMLElement).dataset.lang || 'en';
      const url = new URL(window.location.href);
      if (lang === 'en') url.searchParams.delete('lang');
      else url.searchParams.set('lang', lang);
      window.location.href = url.toString();
    });
  });
</script>
